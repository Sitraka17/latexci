#!/usr/bin/env bash
# latexci macOS launcher — PDF + Website builder
set -euo pipefail

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:$PATH"

# ── 1. Locate latexci binary ──────────────────────────────────────────────────
LATEXCI=""
for candidate in \
    "$HOME/latexci/bin/latexci" \
    "$HOME/go/bin/latexci" \
    "/opt/homebrew/bin/latexci" \
    "/usr/local/bin/latexci"; do
  [[ -x "$candidate" ]] && { LATEXCI="$candidate"; break; }
done
[[ -z "$LATEXCI" ]] && LATEXCI=$(command -v latexci 2>/dev/null || true)

if [[ -z "$LATEXCI" ]]; then
  osascript -e 'display alert "latexci not found" message "Could not find the latexci binary.\n\nInstall with:\n  go install github.com/Sitraka17/latexci/cmd/latexci@latest" as critical buttons {"OK"}'
  exit 1
fi

# ── 2. Choose action ──────────────────────────────────────────────────────────
ACTION=$(osascript <<'APPLESCRIPT'
set btn to button returned of (display dialog "What do you want to build?" ¬
  with title "latexci" ¬
  buttons {"Cancel", "🌐  Website (HTML)", "📄  PDF"} ¬
  default button "📄  PDF" ¬
  with icon note)
return btn
APPLESCRIPT
) || exit 0

# ── 3. Choose project folder ──────────────────────────────────────────────────
PROJECT=$(osascript <<'APPLESCRIPT'
set chosen to choose folder with prompt "Select your LaTeX project folder:"
return POSIX path of chosen
APPLESCRIPT
) || exit 0
PROJECT="${PROJECT%/}"

# ── 4. Choose theme if Website ───────────────────────────────────────────────
THEME="light"
if [[ "$ACTION" == *"Website"* ]]; then
  THEME=$(osascript <<'APPLESCRIPT'
set t to button returned of (display dialog "Choose a website theme:" ¬
  with title "latexci — Theme" ¬
  buttons {"Academic", "Dark", "Light"} ¬
  default button "Light")
return (do shell script "echo " & quoted form of t & " | tr '[:upper:]' '[:lower:]'")
APPLESCRIPT
  ) || THEME="light"
fi

# ── 5. Run in Terminal ────────────────────────────────────────────────────────
LOG_FILE=$(mktemp /tmp/latexci-XXXXXX.log)
LATEXCI_ESC="${LATEXCI//\'/\'\\\'\'}"
PROJECT_ESC="${PROJECT//\'/\'\\\'\'}"

if [[ "$ACTION" == *"Website"* ]]; then
  BUILD_CMD="'${LATEXCI_ESC}' web --theme '${THEME}' --toc 2>&1"
  SUCCESS_MSG="Website built! Opening in browser..."
  OPEN_CMD="open '${PROJECT_ESC}/build/index.html'"
else
  BUILD_CMD="'${LATEXCI_ESC}' build --report 2>&1"
  SUCCESS_MSG="PDF compiled! Opening in Preview..."
  OPEN_CMD="'${LATEXCI_ESC}' open 2>/dev/null || open '${PROJECT_ESC}/build/main.pdf'"
fi

osascript <<APPLESCRIPT
tell application "Terminal"
  activate
  do script "
export PATH=/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin
clear
printf '\\033[36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\033[0m\n'
printf '\\033[36m  latexci  —  ${ACTION}\\033[0m\n'
printf '\\033[36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\033[0m\n'
echo ''
echo '📂  ${PROJECT_ESC}'
echo ''
echo '\\033[33m[1/2] Checking environment...\\033[0m'
'${LATEXCI_ESC}' doctor --config '${PROJECT_ESC}/.latexci.yml' 2>&1
DOCTOR_EXIT=\\\$?
echo ''
if [ \\\$DOCTOR_EXIT -ne 0 ]; then
  echo '\\033[31mFix the issues above, then reopen latexci.\\033[0m'
  echo 1 > '${LOG_FILE}'
else
  echo '\\033[33m[2/2] Building...\\033[0m'
  cd '${PROJECT_ESC}'
  ${BUILD_CMD}
  BUILD_EXIT=\\\$?
  if [ \\\$BUILD_EXIT -eq 0 ]; then
    echo ''
    echo '\\033[32m✓  ${SUCCESS_MSG}\\033[0m'
    ${OPEN_CMD}
  else
    echo '\\033[31m✗  Build failed (exit code \\\$BUILD_EXIT)\\033[0m'
  fi
  echo \\\$BUILD_EXIT > '${LOG_FILE}'
fi
"
end tell
APPLESCRIPT

# ── 6. macOS notification ─────────────────────────────────────────────────────
for i in $(seq 1 300); do
  if [[ -s "$LOG_FILE" ]]; then
    EXIT_CODE=$(cat "$LOG_FILE"); rm -f "$LOG_FILE"
    NAME=$(basename "$PROJECT")
    if [[ "$EXIT_CODE" == "0" ]]; then
      NOTIF_MSG="✓ $(echo "$ACTION" | sed 's/.*  //')"
      osascript -e "display notification \"${NOTIF_MSG}\" with title \"latexci\" subtitle \"${NAME}\" sound name \"Glass\""
    else
      osascript -e "display notification \"Build failed — check Terminal\" with title \"latexci\" subtitle \"${NAME}\" sound name \"Basso\""
    fi
    break
  fi
  sleep 1
done
